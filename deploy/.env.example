# Enki Research Gateway Configuration

# Server & Auth
ENKI_API_KEYS=your-secret-hex-api-key-here
ENKI_DB_PATH=/data/enki_research.db
ENKI_LOG_LEVEL=INFO
ENKI_CONTACT_EMAIL=admin@enkiengine.com

# SearXNG Metasearch (Internal URL)
ENKI_SEARXNG_URL=http://enki-searxng:8080
SEARXNG_SECRET=searxng-secret-key-change-me

# Free Scholarly & Code APIs (Enabled by default)
OPENALEX_ENABLED=true
OPENALEX_API_KEY=
ARXIV_ENABLED=true
SEMANTIC_SCHOLAR_ENABLED=true
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_ENABLED=true
GITHUB_ENABLED=true
GITHUB_TOKEN=

# Commercial APIs within Free Quotas (Enabled only with key & flag)
TAVILY_ENABLED=true
TAVILY_API_KEY=
TAVILY_MONTHLY_LIMIT=1000

EXA_ENABLED=false
EXA_API_KEY=
EXA_MONTHLY_LIMIT_USD=10.0

BRAVE_ENABLED=false
BRAVE_API_KEY=
BRAVE_MONTHLY_LIMIT=1000

# Safety threshold: stop at 90% of free quota limit
ENKI_QUOTA_SAFETY=0.90
